{
  "name": "stent",
  "version": "1.0.0",
  "private": true,
  "description": "No-code x402 reverse proxy — monetize any API per request in USDC via Circle Gateway batched settlement on Arc.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/proxy",
    "apps/demo-origin",
    "apps/dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:proxy": "npm run dev --workspace @stent/proxy",
