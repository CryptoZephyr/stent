    "test": "npm run test --workspaces --if-present",
    "test:proxy": "npm run test --workspace @stent/proxy"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "@x402/core": "^2.16.0",
    "@x402/evm": "^2.16.0",
    "viem": "^2.21.0"
  }
}
